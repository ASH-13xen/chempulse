# Copy to .env.local (website) and set the same values as GitHub Actions secrets (collector).

# MongoDB Atlas connection string: Atlas > Database > Connect > Drivers.
# Leave empty to run on the local JSON files in data/snapshot.
MONGODB_URI=
MONGODB_DB=chempulse

# Password for the website's login screen. Leave empty to turn the login off.
SITE_PASSWORD=
# Any long random string; signs the login cookie.
AUTH_SECRET=

# Any long random string. The collector sends it to /api/revalidate after a run
# that changed prices, so the site shows new numbers immediately.
REVALIDATE_SECRET=
